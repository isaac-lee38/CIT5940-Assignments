import java.util.*;

public class BSTTraversals {

    // Helper method for depth-first traversals
    private void traverse(TreeNode node, List<Integer> res, int type) {
        if (node ==null) return;

        if (type==1) res.add(node.val);
        traverse(root.left,res,type);
        if (type==2) res.add(node.val);
        traverse(root.right,res,type);
        if (type==3) res.add(node.val);
    }

    public List<Integer> preorder(TreeNode root) {
        List<Integer> res = new ArrayList<>();
        traverse(root, res, 1);
        return res;
    }

    
    public List<Integer> inorder(TreeNode root) {
        List<Integer> res = new ArrayList<>();
        traverse(root, res, 2);
        return res;
    }

    public List<Integer> postorder(TreeNode root) {
        List<Integer> res = new ArrayList<>();
        traverse(root, res, 3);
        return res;
    }

    public LIst<Integer> levelorder(TreeNode root){
        List<Integer> res = new ArrayList<>();
        if (root==null) return res;
        
        Queue<TreeNode> bfs= new LinkedList<>();
        //Offer = push into queue
        bfs.offer(root);
        while(!bfs.isEmpty()){
            //Poll = get from front of queue;
            TreeNode front = bfs.poll();
            res.add(front.val);
            if (front.left!=null) bfs.offer(front.left);
            if (front.right!=null) bfs.offer(front.right);
        }
        return res;
    }


}